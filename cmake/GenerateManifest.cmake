find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/../tools/generate_manifest_header.py --check RESULT_VARIABLE manifest_result)
execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/../tools/generate_harness_header.py --check RESULT_VARIABLE harness_result)
execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/../tools/generate_calibration_header.py --check RESULT_VARIABLE calibration_result)
execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/../tools/generate_protocol_fixture_header.py --check RESULT_VARIABLE protocol_fixture_result)
execute_process(COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/../tools/verify_upstream_contract.py RESULT_VARIABLE upstream_contract_result)
if(NOT manifest_result EQUAL 0 OR NOT harness_result EQUAL 0 OR NOT calibration_result EQUAL 0 OR NOT protocol_fixture_result EQUAL 0 OR NOT upstream_contract_result EQUAL 0)
  message(FATAL_ERROR "generated configuration or pinned upstream contract verification failed")
endif()
